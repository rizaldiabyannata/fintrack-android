<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingVertical="36dp"
    tools:context=".ui.addBudget.AddBudgetFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">

        <!-- Header -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_kembali_tambah_anggaran"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/arrow_back_24px"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_tambah_anggaran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2.5dp"
            android:paddingLeft="6dp"
            android:text="Tambah Anggaran"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/button_kembali_tambah_anggaran"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/line_under"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/darkGrey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_kembali_tambah_anggaran" />


        <!-- Form Content -->
        <!-- Label Tipe Transaksi -->
        <TextView
            android:id="@+id/label_tipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tipe Transaksi"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line_under" />

        <!-- Pilihan Tipe (RadioGroup) -->
        <RadioGroup
            android:id="@+id/radiogroup_tipe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_tipe">

            <RadioButton
                android:id="@+id/radio_pendapatan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:fontFamily="@font/poppins_regular"
                android:text="Pendapatan" />

            <RadioButton
                android:id="@+id/radio_pengeluaran"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_regular"
                android:text="Pengeluaran" />
        </RadioGroup>

        <!-- Label Tanggal -->
        <TextView
            android:id="@+id/label_tanggal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tanggal"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radiogroup_tipe" />

        <!-- CalendarView untuk memilih tanggal -->
        <CalendarView
            android:id="@+id/calendar_view_tanggal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_tanggal" />

        <!-- Form Total dengan TextInputLayout -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_total"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Total"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/calendar_view_tanggal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edittext_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Form Kategori dengan TextInputLayout (Dropdown) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_kategori"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Kategori"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_total">

            <AutoCompleteTextView
                android:id="@+id/autocompletetext_kategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Form Catatan dengan TextInputLayout -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_catatan"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Catatan (Opsional)"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_kategori">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edittext_catatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:fontFamily="@font/poppins_regular"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tombol Simpan -->
        <Button
            android:id="@+id/button_simpan_transaksi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:padding="12dp"
            android:text="Simpan Transaksi"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_catatan" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
